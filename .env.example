# Copie este ficheiro para ".env" (ou ".env.local") e preencha os valores.
# Se uma variável ficar vazia ou por preencher, a respetiva integração
# simplesmente não é carregada — não é preciso remover nada do código.

# Google Analytics 4 — Measurement ID (formato: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Meta Pixel — ID do pixel (apenas números)
VITE_META_PIXEL_ID=
